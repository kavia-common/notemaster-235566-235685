# --- CORS / Frontend integration ---
# Comma-separated list of allowed origins (e.g. Next.js dev/prod URLs)
ALLOWED_ORIGINS=http://localhost:3000
# Optional: comma-separated, otherwise defaults to "*"
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=3600

# --- Postgres connection (provided by notes_database container) ---
# Either provide a full connection string:
# POSTGRES_URL=postgresql://user:password@host:port/dbname
# ...or provide host in POSTGRES_URL and the rest via vars below:
POSTGRES_URL=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
